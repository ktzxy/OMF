#===============================================================================
# OMF 配置文件模板 (脱敏)
# 用法: cp conf/omf.conf.example conf/omf.conf && 按需修改
# 修改后执行: omf config validate
# 注意: 真实密码建议通过环境变量注入 (export ORACLE_PASSWORD=xxx),
#       或运行 `omf config password` 交互式写入独立的 conf/.omf.secret (权限 600, 不落 shell 历史).
#       优先级: 环境变量 > .omf.secret > omf.conf > 出厂默认。
#===============================================================================

# ===== 数据库配置 =====
ORACLE_USER="oracle"
ORACLE_GROUP="oinstall"
ORACLE_BASE="/u01/app/oracle"
# ORACLE_HOME 留空则按 ORACLE_VERSION 自动推导 (19 -> /u01/app/oracle/product/19.3.0/dbhome_1)
# 如需自定义安装路径, 显式指定即可覆盖:
# ORACLE_HOME="/u01/app/oracle/product/19.3.0/dbhome_1"
ORACLE_HOME=""
# Oracle 主版本 (仅支持 CDB 系列: 18 / 19 / 21 / 23); 用于推导默认安装包名与 CVU 兼容假名
ORACLE_VERSION="19"
# 安装包 zip 路径 (留空则按 ORACLE_VERSION 推导默认名, 如 LINUX.X64_193000_db_home.zip)
ORACLE_ZIP=""
ORACLE_SID="ARTERY"
PDB_NAME="ARTERYPDB"
# 监听器端口 (默认 1521); 用 omf listener port <新端口> 修改会同步写回此处
LISTENER_PORT="1521"

# ===== 内存规划 (用于 SGA / HugePages 估算) =====
# Oracle 内存占物理内存百分比 (默认 80)
ORACLE_MEM_RATIO="80"
# SGA 占 Oracle 内存百分比 (默认 75)
SGA_RATIO="75"
# 预留大页后至少给 OS 保留的空闲内存(MB), 防止小内存机器被大页吃满 (默认 2048)
HUGEPAGES_RESERVE_FREE_MB="2048"
# 是否将大页预留推迟到 omf db create 之前 (true/false)
#   true:  env prepare 不立即预留大页(释放内存给安装器), 建库前再预留
#   false: env prepare 立即预留大页(传统行为)
HUGEPAGES_DEFER="false"

# ===== 密码配置 =====
# 注意: 此处为脱敏占位符 (代码出厂默认与模板不同, 且均会被 omf config validate 判为弱口令)。
# 生产务必替换, 推荐用 `omf config password` 写入独立的 conf/.omf.secret (权限 600), 或环境变量注入。
# 优先级: 环境变量 > .omf.secret > conf/omf.conf > 出厂默认。
ORACLE_PASSWORD="${ORACLE_PASSWORD:-ChangeMe_123}"
SYSTEM_PASSWORD="${SYSTEM_PASSWORD:-ChangeMe_123}"
PDB_PASSWORD="${PDB_PASSWORD:-ChangeMe_123}"

# ===== 应用模式 / 多模式(多库) (omf sql init 使用) =====
# 单模式(传统): 仅配 APP_USER/APP_PASSWORD/APP_TABLESPACE 即可。
#   Oracle 中 模式 = 用户, 改 APP_USER 即同时改用户名与模式名; 数据文件路径由
#   ORACLE_DATA + ORACLE_SID 推导为 ${ORACLE_DATA}/${ORACLE_SID}/<用户>/dataNN.dbf
#   表空间数据文件个数/大小: APP_DATAFILES(默认4个) / APP_DATAFILE_SIZE_MB(默认1024M),
#   可全局设或按 <大写模式名>_DATAFILES / _DATAFILE_SIZE_MB 覆盖 (适配小库减小/大库增大)
APP_DATAFILES="4"
APP_DATAFILE_SIZE_MB="1024"
# 多模式(多库, 如批号库 dherp + 连锁库 lsdherp + ...):
#   用 APP_SCHEMAS 列出所有模式(空格分隔), 框架自动逐个建用户/表空间。
#   每个模式可用 <大写模式名>_USER / _PASSWORD / _TABLESPACE / _DATA_DIR 个别覆盖,
#   缺省: 用户名=表空间名=模式名, 密码=全局 APP_PASSWORD, 数据目录=<SID>/<模式名>。
# 示例(取消注释启用双模式):
#   APP_SCHEMAS="dherp lsdherp"
#   LSDHERP_PASSWORD="ls_pwd"          # 连锁库独立密码
#   LSDHERP_TABLESPACE="ls_ts"         # 连锁库独立表空间
#   MISERP_DATA_DIR="/data/oracle/oradata/ARTERY/miserp"  # 第3个库可指定数据目录
APP_USER="dherp"
APP_PASSWORD="${APP_PASSWORD:-ChangeMe_123}"
APP_TABLESPACE="${APP_TABLESPACE:-dherp}"
APP_SCHEMAS=""

# ===== 存储路径 =====
ORACLE_DATA_BASE="/data/oracle"
ORACLE_DATA="/data/oracle/oradata"
ORACLE_ARCH="/data/oracle/archivelog"
ORACLE_FRA="/data/oracle/fast_recovery"
ORACLE_BACKUP="/backup/oracle"
# 数据泵导入目录 (impdp 的 DIRECTORY 对象指向的 OS 路径; omf sql init 会自动建好)
ORACLE_DUMP_DIR="/data/oracle/oracle_dumps"

# ===== 数据库参数 =====
CHARSET="AL32UTF8"
NLS_LANG="AMERICAN_AMERICA.AL32UTF8"
PROCESSES="1500"
OPEN_CURSORS="1000"
REDO_SIZE_MB="2048"
# FRA (快速恢复区) 大小(MB). 注意: 若配置值超过 FRA 所在磁盘的可用空间,
# omf db create 会自动下调到"可用空间 - 15GB(预留给数据文件+归档)"并告警, 避免 DBCA 报 DBT-06604 建库失败.
# 生产环境建议将 /data/oracle 单独挂载到足够大的磁盘, 使此处 40GB 能真实生效.
FRA_SIZE_MB="40960"
FRA_SIZE_MB_MIN="20480"

# ===== Data Guard =====
ENABLE_DG="false"
PRIMARY_IP="192.168.0.108"
STANDBY_IP="192.168.0.110"
STANDBY_SID="${STANDBY_SID:-ARTERY}"

# ===== 备份策略 =====
BACKUP_MODE="both"
BACKUP_RETENTION_DAYS="30"
# 即将过期高亮阈值(天): 留空则按保留期的 1/5 自动计算(钳制 2~7 天); 设置后固定按该值
BACKUP_WARN_DAYS=""
BACKUP_COMPRESSION="ALL"
BACKUP_PARALLEL="4"

# ===== 框架自更新 =====
OMF_UPDATE_URL="${OMF_UPDATE_URL:-}"
# 可选: 压缩包 sha256 (用于 self-update 完整性校验, 留空则不校验)
OMF_UPDATE_SHA256="${OMF_UPDATE_SHA256:-}"

# ===== 清理策略 =====
LOG_RETENTION_DAYS="7"
AUDIT_RETENTION_DAYS="30"
TRACE_RETENTION_DAYS="7"

# ===== 告警通知 (omf check monitor --alert 等触发) =====
# 通用 webhook: 设 URL 即启用, 兼容 alertmanager / 钉钉 / 企业微信 的入站 webhook
#   OMF_NOTIFY_WEBHOOK_FMT 取值: raw(默认, 推送 {"title","content"}) / dingtalk(text) / wechat(markdown)
#   例(钉钉群机器人):
#     OMF_NOTIFY_WEBHOOK="https://oapi.dingtalk.com/robot/send?access_token=xxxx"
#     OMF_NOTIFY_WEBHOOK_FMT="dingtalk"
#   例(企业微信群机器人):
#     OMF_NOTIFY_WEBHOOK="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx"
#     OMF_NOTIFY_WEBHOOK_FMT="wechat"
#   例(对接 Prometheus Alertmanager 的 webhook receiver):
#     OMF_NOTIFY_WEBHOOK="http://alertmanager:9093/api/v2/alerts"
#     OMF_NOTIFY_WEBHOOK_FMT="raw"
#OMF_NOTIFY_WEBHOOK=""
#OMF_NOTIFY_WEBHOOK_FMT="raw"
# 邮件兜底 (需系统有 mail 命令): 设收件人即启用
#OMF_NOTIFY_MAIL=""
# 自定义钩子: 把 conf/notify.sh.example 复制为 conf/notify.sh 并 chmod +x 即可接管全部通知

# ===== 监控告警阈值 (omf check monitor --alert) =====
# 磁盘/内存阈值 (原有关键项):
#MONITOR_DISK_WARN_PCT="85"
#MONITOR_DISK_ERR_PCT="92"
#MONITOR_MEM_WARN_PCT="20"
#MONITOR_MEM_ERR_PCT="10"
# 扩展阈值 (本轮新增, 覆盖无效对象/表空间/备份时效/DG延迟):
#   无效对象数: warn 触发 WARN, err 触发 ALERT
#MONITOR_INVALID_WARN="20"
#MONITOR_INVALID_ERR="100"
#   表空间最大使用率 (%): 取所有表空间中最高使用率
#MONITOR_TBS_WARN_PCT="85"
#MONITOR_TBS_ERR_PCT="92"
#   备份时效: 最近一次成功全量备份距今天数超过此值触发 WARN; 0 或留空=不检查
#MONITOR_BACKUP_MAX_DAYS="1"
#   DG 应用延迟 (秒): 仅 ENABLE_DG=true 时采集; 超过此秒数触发 WARN (默认 600=10分钟)
#MONITOR_DG_LAG_WARN_SEC="600"
#   FRA(快速恢复区)使用率 (%): 满仓会阻塞归档/备份, warn 触发 WARN, err 触发 ALERT
#MONITOR_ARCH_WARN_PCT="80"
#MONITOR_ARCH_ERR_PCT="90"
#   CPU 使用率 (%): 持续高 CPU 是生产瓶颈信号, warn 触发 WARN, err 触发 ALERT
#MONITOR_CPU_WARN_PCT="90"
#MONITOR_CPU_ERR_PCT="98"

# ===== RMAN 备份重试策略 (omf backup {auto|physical|incr}) =====
#   网络存储抖动等偶发瞬断会导致 RMAN 误报失败, 启用重试可消除误报。
#   重试次数: 失败后再尝试的次数 (共最多 retries+1 次); 0=不重试, 直接判定结果
#RMAN_RETRY="1"
#   重试间隔秒: 每次重试前的等待秒数
#RMAN_RETRY_INTERVAL="5"

# ===== 运行日志 =====
# 结构化日志: true 时 logs/omf_*.log 以 JSON Lines 输出 {"ts","level","cmd","sub","msg"},
#   便于接入 ELK/日志监控; 默认 false (文本格式, 行首附 [cmd=X][sub=Y] 结构化前缀)
#OMF_LOG_STRUCTURED="false"
